---
import * as cv from "../content/cv.md";
const { frontmatter } = cv;
import Layout from "../layouts/Layout.astro";

import * as test from "../content/test.md";
---

<Layout title="CV">
    <div id="cv-title">
        <h1 class="post-title" style="display: inline;">Curriculum Vitae</h1>
        <a href="/cv-esbae.pdf" target="_blank" style="margin-left: 20px;">[DOWNLOAD]</a>
        <hr style="margin-top: 10px; margin-bottom: 0px;"><br />
    </div>
    <div id="contact-info">
        <center>
            {frontmatter.author && (
            <>
                <font size="8">{frontmatter.author}</font>
            </>
            )}
            <br />

            {frontmatter.position && (
            <>
                {frontmatter.position}
            </>
            )}
            {frontmatter.affiliation1 && (
            <>
                , {" "}{frontmatter.affiliation1}
                <br />
            </>
            )}            
            {frontmatter.affiliation2 && (
            <>
                {frontmatter.affiliation2} <br />
            </>
            )}

            {frontmatter.email && (
            <>
                <span class="contact-item">
                <a
                href={frontmatter.email.url}
                style="margin-left: 0.5em"
                >
                {frontmatter.email.text}
                </a>
                </span>
            </>
            )}
            {frontmatter.homepage && (
            <>
                <span class="contact-item">
                <a
                href={frontmatter.homepage.url}
                style="margin-left: 0.5em"
                >
                {frontmatter.homepage.text}
                </a>
                </span>
            </>
            )}
            {frontmatter.date && (
            <>
                <span class="contact-item">
                Updated: {frontmatter.date}
                </span>
            </>
            )}
        </center>
        <br />
    </div>
    <div class="markdown-cv">    
        <cv.Content />
        <!-- <test.Content /> -->
    </div>
</Layout>